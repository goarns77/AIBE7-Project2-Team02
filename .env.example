# PostgreSQL connection used by application-db.yaml
DB_HOST=localhost
DB_NAME=matcheat
DB_USERNAME=
DB_PASSWORD=

# Base64-encoded random secret of at least 32 decoded bytes.
JWT_SECRET=
JWT_ISSUER=https://matcheat.local
JWT_AUDIENCE=matcheat-api
JWT_ACCESS_TOKEN_TTL=PT1H

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# google ai
GEMINI_API_KEY=AQ.****

# Kakao REST api
KAKAO_REST_API_KEY=