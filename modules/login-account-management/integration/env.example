# Copy these names to the repository root .env and provide real local values.
DB_URL=jdbc:postgresql://localhost:5432/matcheat
DB_USERNAME=
DB_PASSWORD=

# Base64-encoded random secret of at least 32 decoded bytes.
JWT_SECRET=
JWT_ISSUER=https://matcheat.local
JWT_AUDIENCE=matcheat-api
JWT_ACCESS_TOKEN_TTL=PT1H

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
